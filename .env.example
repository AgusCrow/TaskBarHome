# Puerto del servidor backend
PORT=3001

# Ruta absoluta o relativa a la bóveda de Obsidian
# Por defecto se utiliza la bóveda de prueba local del proyecto
OBSIDIAN_VAULT_PATH=./mock-vault

# Ruta a la carpeta de fotos para el fondo de pantalla
PHOTOS_PATH=./mock-vault/photos

# Configuración del clima (Open-Meteo)
# Ejemplo: Buenos Aires (-34.6037, -58.3816)
WEATHER_LATITUDE=-34.6037
WEATHER_LONGITUDE=-58.3816
WEATHER_CITY_NAME="Buenos Aires"
